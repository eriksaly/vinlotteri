# Copy to .env and fill in. Read by both docker-compose.yml and the Spring app
# (spring.config.import in application.yaml); real environment variables override it.

# Postgres, used by the compose db service and the app's datasource. Without DB_PORT the
# database gets a random host port; pin one to give IntelliJ's data source a stable address
#DB_PORT=5432
DB_NAME=wineforall
DB_USER=postgres
DB_PASSWORD=

# Google OAuth client from the Google Cloud console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional app settings (defaults in application.yaml)
#BOOTSTRAP_ADMIN_EMAIL=esa@isys.no
#ALLOWED_EMAILS=
#ALLOWED_ORIGIN=http://localhost:5173
#VIPPS_NUMBER=12345678
#BACKGROUND_JOBS_ENABLED=true
#PORT=8080
